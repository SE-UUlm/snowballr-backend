<?xml version="1.1" encoding="UTF-8" ?>
<!DOCTYPE configuration>
<configuration>
    <import class="ch.qos.logback.classic.encoder.PatternLayoutEncoder"/>
    <import class="ch.qos.logback.core.ConsoleAppender"/>

    <appender name="STDOUT" class="ConsoleAppender">
        <encoder class="PatternLayoutEncoder">
            <!-- The MDC blocks colour themselves with raw ANSI escapes (&#27;) inside the replacement string: a
                 colour converter wrapping or preceding %replace breaks pattern parsing, and colouring the whole
                 block would emit escape codes on every line that carries no correlation IDs. Requires XML 1.1,
                 which is why the declaration above is not 1.0. -->
            <pattern>%cyan([%d{YY-MM-dd HH:mm:ss.SSS}]) %highlight(%-5level) %magenta([%thread{10}]) %logger{36}%replace(%X{requestId}){'.+', ' &#27;[36m[req=$0]&#27;[0;39m'}%replace(%X{userId}){'.+', ' &#27;[35m[user=$0]&#27;[0;39m'}: %msg%n</pattern>
        </encoder>
    </appender>
    <root level="debug">
        <appender-ref ref="STDOUT"/>
    </root>
    <logger name="io.grpc.netty.shaded" level="INFO"/>
    <logger name="com.zaxxer.hikari.pool" level="INFO"/>
</configuration>
