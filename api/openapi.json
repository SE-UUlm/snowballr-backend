{
    "openapi": "3.1.0",
    "info": {
        "title": "SnowballR API",
        "description": "REST API for the SnowballR Application",
        "version": "v1"
    },
    "servers": [
        {
            "url": "http://localhost",
            "description": "Generated server url"
        }
    ],
    "paths": {
        "/projects": {
            "get": {
                "tags": [
                    "project-controller"
                ],
                "operationId": "getAllProjects",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Project"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "project-controller"
                ],
                "operationId": "createProject",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateProjectRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/Project"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/projects/{id}": {
            "get": {
                "tags": [
                    "project-controller"
                ],
                "operationId": "getProject",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/Project"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "project-controller"
                ],
                "operationId": "deleteProject",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "CreateProjectRequest": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    }
                }
            },
            "DecisionMatrixPattern": {
                "type": "object",
                "properties": {
                    "decision": {
                        "type": "string",
                        "enum": [
                            "UNREVIEWED",
                            "IN_REVIEW",
                            "DECLINED",
                            "ACCEPTED"
                        ]
                    },
                    "entries": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/DecisionMatrixPatternEntry"
                        }
                    }
                }
            },
            "DecisionMatrixPatternEntry": {
                "type": "object",
                "properties": {
                    "decision": {
                        "type": "string",
                        "enum": [
                            "DECLINED",
                            "MAYBE",
                            "ACCEPTED"
                        ]
                    },
                    "count": {
                        "type": "integer",
                        "format": "int32"
                    }
                }
            },
            "Project": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "name": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "ACTIVE",
                            "ACTIVE_LOCKED",
                            "ARCHIVED",
                            "DELETED",
                            "CLEARED"
                        ]
                    },
                    "currentStage": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "maxStage": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "similarityThreshold": {
                        "type": "number",
                        "format": "float"
                    },
                    "snowballingType": {
                        "type": "string",
                        "enum": [
                            "FORWARD",
                            "BACKWARD",
                            "BOTH"
                        ]
                    },
                    "reviewMaybeAllowed": {
                        "type": "boolean"
                    },
                    "reviewDecisionMatrix": {
                        "$ref": "#/components/schemas/ReviewDecisionMatrix"
                    },
                    "fetchers": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "currentStageStartedAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "createdBy": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "modifiedAt": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "modifiedBy": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "uuid"
                    },
                    "deletedAt": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "deletedBy": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "uuid"
                    },
                    "archivedAt": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "archivedBy": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "uuid"
                    },
                    "active": {
                        "type": "boolean"
                    },
                    "deleted": {
                        "type": "boolean"
                    }
                }
            },
            "ReviewDecisionMatrix": {
                "type": "object",
                "properties": {
                    "numberOfReviewers": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "patterns": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/DecisionMatrixPattern"
                        }
                    }
                }
            }
        }
    }
}
