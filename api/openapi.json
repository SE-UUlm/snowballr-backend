{
    "openapi": "3.1.0",
    "info": {
        "title": "SnowballR API",
        "description": "REST API for the SnowballR Application",
        "version": "v1"
    },
    "servers": [
        {
            "url": "http://localhost",
            "description": "Generated server url"
        }
    ],
    "paths": {
        "/api/v1/users": {
            "post": {
                "tags": [
                    "users-controller"
                ],
                "operationId": "register",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegisterRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Created"
                    }
                }
            }
        },
        "/api/v1/projects": {
            "get": {
                "tags": [
                    "projects-controller"
                ],
                "operationId": "getAllProjects",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/ProjectResponse"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "projects-controller"
                ],
                "operationId": "createProject",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateProjectRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Created",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProjectResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/auth/verify-email": {
            "post": {
                "tags": [
                    "auth-controller"
                ],
                "operationId": "verifyEmail",
                "parameters": [
                    {
                        "name": "token",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/api/v1/auth/logout": {
            "post": {
                "tags": [
                    "auth-controller"
                ],
                "operationId": "logout",
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/api/v1/auth/login": {
            "post": {
                "tags": [
                    "auth-controller"
                ],
                "operationId": "login",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/api/v1/auth/change-password": {
            "post": {
                "tags": [
                    "auth-controller"
                ],
                "operationId": "changePassword",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ChangePasswordRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/api/v1/projects/{id}": {
            "get": {
                "tags": [
                    "projects-controller"
                ],
                "operationId": "getProject",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProjectResponse"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "projects-controller"
                ],
                "operationId": "deleteProject",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/api/v1/auth/status": {
            "get": {
                "tags": [
                    "auth-controller"
                ],
                "operationId": "getAuthStatus",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "string",
                                    "enum": [
                                        "UNAUTHENTICATED",
                                        "ACCESS_TOKEN_EXPIRED",
                                        "AUTHENTICATED"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "RegisterRequest": {
                "type": "object",
                "properties": {
                    "firstName": {
                        "type": "string"
                    },
                    "lastName": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "password": {
                        "type": "string"
                    }
                }
            },
            "CreateProjectRequest": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    }
                }
            },
            "DecisionMatrixPattern": {
                "type": "object",
                "properties": {
                    "decision": {
                        "type": "string",
                        "enum": [
                            "UNREVIEWED",
                            "IN_REVIEW",
                            "DECLINED",
                            "ACCEPTED"
                        ]
                    },
                    "entries": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/DecisionMatrixPatternEntry"
                        }
                    }
                }
            },
            "DecisionMatrixPatternEntry": {
                "type": "object",
                "properties": {
                    "decision": {
                        "type": "string",
                        "enum": [
                            "DECLINED",
                            "MAYBE",
                            "ACCEPTED"
                        ]
                    },
                    "count": {
                        "type": "integer",
                        "format": "int32"
                    }
                }
            },
            "ProjectResponse": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "name": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "ACTIVE",
                            "ACTIVE_LOCKED",
                            "ARCHIVED",
                            "DELETED",
                            "CLEARED"
                        ]
                    },
                    "currentStage": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "maxStage": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "similarityThreshold": {
                        "type": "number",
                        "format": "float"
                    },
                    "snowballingType": {
                        "type": "string",
                        "enum": [
                            "FORWARD",
                            "BACKWARD",
                            "BOTH"
                        ]
                    },
                    "reviewMaybeAllowed": {
                        "type": "boolean"
                    },
                    "reviewDecisionMatrix": {
                        "$ref": "#/components/schemas/ReviewDecisionMatrix"
                    },
                    "fetchers": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "currentStageStartedAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "ReviewDecisionMatrix": {
                "type": "object",
                "properties": {
                    "numberOfReviewers": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "patterns": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/DecisionMatrixPattern"
                        }
                    }
                }
            },
            "LoginRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string"
                    },
                    "password": {
                        "type": "string"
                    }
                }
            },
            "ChangePasswordRequest": {
                "type": "object",
                "properties": {
                    "oldPassword": {
                        "type": "string"
                    },
                    "newPassword": {
                        "type": "string"
                    }
                }
            }
        }
    }
}
